{
    "bilibili": {
        "sessdata": "YOUR_SESSDATA_HERE",
        "bili_jct": "YOUR_BILI_JCT_HERE",
        "bot_mid": 0,
        "bot_name": "你的Bot名称"
    },
    "zhipu": {
        "api_key": "YOUR_ZHIPU_API_KEY_HERE"
    },
    "channels": {
        "qqbot": {
            "appId": "YOUR_BOT_APPID_HERE",
            "clientSecret": "YOUR_BOT_CLIENT_SECRET_HERE",
            "openid": "YOUR_RECIPIENT_OPENID_HERE"
        }
    },
    "monitor": {
        "poll_interval": 15,
        "work_dir": "data/work",
        "state_file": "data/state/replied_ids.txt",
        "summary_file": "data/cache/video_summaries.json",
        "active_threads_file": "data/state/active_threads.json",
        "at_fallback_interval": 3600,
        "reply_fallback_interval": 3600
    },
    "asr": {
        "local_first": true,
        "local_model": "iic/SenseVoiceSmall",
        "local_vad_model": "iic/speech_fsmn_vad_zh-cn-16k-common-pytorch",
        "local_max_seg_ms": 15000,
        "local_threads": 8
    },
    "visual": {
        "model_chain": [
            "glm-4.6v-flash",
            "glm-4v-flash"
        ]
    },
    "proxy": {
        "host": "127.0.0.1",
        "port": 7890
    },
    "github": {
        "token": "YOUR_GITHUB_TOKEN_HERE",
        "repo": "",
        "note": "token 仅用于项目上传至 GitHub, 不参与脚本运行"
    },
    "ad_detection": {
        "enabled": true
    },
    "deepseek": {
        "api_key": "",
        "model": "deepseek-v4-pro",
        "base_url": "https://api.deepseek.com"
    }
}
